Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: MsNonBusinessDay
Bundle-SymbolicName: com.metalsistem.nonbusinessday
Bundle-Version: 13.0.0.qualifier
Import-Package: org.osgi.framework,
 org.zkoss.json
Require-Bundle: org.adempiere.plugin.utils;bundle-version="11.0.0",
 org.adempiere.base;bundle-version="11.0.0",
 org.osgi.service.component.annotations;bundle-version="1.5.1",
